# ===========================================================
# Copy this file to ".env" and change the values if needed.
#   Windows:     copy .env.example .env
#   Mac/Linux:   cp .env.example .env
# NEVER commit your real .env file to Git.
# ===========================================================

# Port where the Express server runs
PORT=5000

# MongoDB connection string
#  - Local MongoDB:   mongodb://127.0.0.1:27017/todo_db
#  - MongoDB Atlas:   mongodb+srv://<username>:<password>@<cluster-url>/todo_db
MONGODB_URI=mongodb://127.0.0.1:27017/todo_db

# Maximum upload size in megabytes
MAX_FILE_SIZE_MB=5

# Which website is allowed to call the API (CORS). "*" = any (fine for development)
CLIENT_ORIGIN=*
